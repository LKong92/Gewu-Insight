#!/bin/zsh
set -u

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd -P)"
PROJECT_DIR="$(cd "$SCRIPT_DIR/../../.." && pwd -P)"
LOG_DIR="$PROJECT_DIR/logs"
LOG_FILE="$LOG_DIR/paper_monitor_launcher.log"
PORT="${PAPER_MONITOR_PORT:-8765}"
HOST="${PAPER_MONITOR_HOST:-127.0.0.1}"
URL="http://$HOST:$PORT"
VENV_DIR="$PROJECT_DIR/.venv"
PYTHON_BIN="$VENV_DIR/bin/python"
REQ_FILE="$PROJECT_DIR/requirements.txt"
REQ_STAMP="$VENV_DIR/.paper_monitor_requirements_installed"

mkdir -p "$LOG_DIR"

{
  echo ""
  echo "=== Paper Monitor launch $(date) ==="
  echo "Project: $PROJECT_DIR"
  echo "URL: $URL"
} >>"$LOG_FILE"

show_failure() {
  ERROR_TEXT="$(/usr/bin/tail -n 18 "$LOG_FILE" | /usr/bin/sed 's/\\/\\\\/g; s/"/\\"/g')"
  /usr/bin/osascript -e "display dialog \"Paper Monitor could not start. Recent log:\\n\\n$ERROR_TEXT\\n\\nFull log: $LOG_FILE\" buttons {\"OK\"} default button \"OK\" with icon caution" >/dev/null 2>&1 || true
  /usr/bin/open -R "$LOG_FILE" >/dev/null 2>&1 || true
}

run_or_fail() {
  "$@" >>"$LOG_FILE" 2>&1
  STATUS=$?
  if [ "$STATUS" -ne 0 ]; then
    echo "Command failed ($STATUS): $*" >>"$LOG_FILE"
    show_failure
    exit "$STATUS"
  fi
}

mkdir -p "$PROJECT_DIR/data" "$PROJECT_DIR/reports" >>"$LOG_FILE" 2>&1 || {
  echo "Could not create data/reports directories." >>"$LOG_FILE"
  show_failure
  exit 1
}

cd "$PROJECT_DIR" >>"$LOG_FILE" 2>&1 || {
  echo "Could not enter project directory: $PROJECT_DIR" >>"$LOG_FILE"
  show_failure
  exit 1
}

if [ ! -f "$REQ_FILE" ] || [ ! -d "$PROJECT_DIR/paper_monitor" ]; then
  echo "This app must stay inside the Paper Monitor project folder. Missing requirements.txt or paper_monitor/." >>"$LOG_FILE"
  show_failure
  exit 1
fi

case "$PROJECT_DIR" in
  "$HOME/Desktop"|"$HOME/Desktop"/*|"$HOME/Documents"|"$HOME/Documents"/*|"$HOME/Downloads"|"$HOME/Downloads"/*)
    echo "This project is inside Desktop, Documents, or Downloads. macOS may block Finder-launched Python from reading these protected folders." >>"$LOG_FILE"
    echo "Move the whole PaperMonitor folder to a regular folder such as $HOME/Applications or $HOME/PaperMonitor, then open Paper Monitor.app again." >>"$LOG_FILE"
    show_failure
    exit 1
    ;;
esac

if [ ! -x "$PYTHON_BIN" ]; then
  SYSTEM_PYTHON="$(/usr/bin/env which python3 2>/dev/null || true)"
  if [ -z "$SYSTEM_PYTHON" ]; then
    echo "python3 was not found. Install Python 3 from https://www.python.org/downloads/macos/ or Homebrew, then open Paper Monitor again." >>"$LOG_FILE"
    show_failure
    exit 1
  fi
  echo "Creating virtual environment with $SYSTEM_PYTHON" >>"$LOG_FILE"
  run_or_fail "$SYSTEM_PYTHON" -m venv "$VENV_DIR"
fi

if ! "$PYTHON_BIN" -m pip --version >/dev/null 2>&1; then
  echo "Installing pip into virtual environment" >>"$LOG_FILE"
  run_or_fail "$PYTHON_BIN" -m ensurepip --upgrade
fi

if [ ! -f "$REQ_STAMP" ] || [ "$REQ_FILE" -nt "$REQ_STAMP" ]; then
  echo "Installing Paper Monitor dependencies..." >>"$LOG_FILE"
  run_or_fail "$PYTHON_BIN" -m pip install -r "$REQ_FILE"
  /usr/bin/touch "$REQ_STAMP"
fi

if /usr/bin/curl -fsS "$URL" 2>/dev/null | /usr/bin/grep -q "Paper Monitor"; then
  echo "UI is already running at $URL" >>"$LOG_FILE"
  /usr/bin/open "$URL"
  exit 0
fi

echo "Starting Paper Monitor UI at $URL" >>"$LOG_FILE"
exec "$PYTHON_BIN" -m paper_monitor ui --host "$HOST" --port "$PORT" --open >>"$LOG_FILE" 2>&1
