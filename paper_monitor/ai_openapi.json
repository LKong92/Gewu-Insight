          "413": {
            "description": "Size limit exceeded"
          },
          "422": {
            "description": "PDF text unavailable"
          },
          "429": {
            "description": "Read capacity busy; retry shortly"
          },
          "503": {
            "description": "Temporary failure; retry saves with the same request ID"
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "gewu_key": {
                    "type": "string",
                    "description": "Stable Gewu Key, for example gw_0123456789."
                  },
                  "title": {
                    "type": "string",
                    "maxLength": 120
                  },
                  "markdown": {
                    "type": "string"
                  },
                  "request_id": {
                    "type": "string",
                    "pattern": "^[a-zA-Z0-9_-]{8,100}$"
                  },
                  "source_file_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "source_sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "pages": {
                    "type": "array",
                    "items": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "maxItems": 100
                  }
                },
                "required": [
                  "gewu_key",
                  "markdown",
                  "request_id"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    },
