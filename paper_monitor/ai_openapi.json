    "/api/v1/papers/{gewu_key}/files/{file_id}/content": {
      "get": {
        "operationId": "downloadFile",
        "summary": "Download a registered file (maximum 64 MiB). Requires files:read and an authorized Gewu Key.",
        "security": [
          {
            "GewuToken": []
          }
        ],
        "parameters": [
          {
            "name": "gewu_key",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^gw_[0-9a-f]{10,64}$"
            }
          },
          {
            "name": "file_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^(default|[0-9]+)$"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "File bytes",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "401": {
            "description": "Invalid token"
          },
          "403": {
            "description": "Missing permission"
          },
          "404": {
            "description": "File unavailable"
          }
        }
