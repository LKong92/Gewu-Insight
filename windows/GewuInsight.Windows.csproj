<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Gewu Insight</AssemblyName>
    <Version>0.1.0</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>GewuInsight.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
    <Content Include="GewuInsight.ico" CopyToOutputDirectory="PreserveNewest" />
    <!-- A distinct Shell icon location avoids the cache of the original padded
         icon. Both resources contain the same existing full-size brand mark. -->
    <Content Include="GewuInsight.ico" Link="GewuInsight.Taskbar.ico" CopyToOutputDirectory="PreserveNewest" />
    <EmbeddedResource Include="workspace.js" LogicalName="GewuInsight.Windows.workspace.js" />
    <EmbeddedResource Include="pdf-preview.js" LogicalName="GewuInsight.Windows.pdf-preview.js" />
    <EmbeddedResource Include="../paper_monitor/pdf_source_hosts.txt" LogicalName="GewuInsight.Windows.pdf_source_hosts.txt" />
    <EmbeddedResource Include="../scripts/GewuBrowserCaptureProbe.js" LogicalName="GewuInsight.Windows.capture.js" />
  </ItemGroup>
  <Target Name="RemoveUnusedWebViewWpf" BeforeTargets="ResolveAssemblyReferences">
    <ItemGroup><Reference Remove="@(Reference)" Condition="'%(Reference.Filename)' == 'Microsoft.Web.WebView2.Wpf'" /></ItemGroup>
  </Target>
</Project>
